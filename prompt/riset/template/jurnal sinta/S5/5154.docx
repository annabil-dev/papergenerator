<style>
/* ══════════════════════════════════════════════
   ARTICLE DETAILS v2 — Structured Journal Style
   ══════════════════════════════════════════════ */
:root {
    --c-navy:   #072A61;
    --c-blue:   #063B90;
    --c-orange: #FF8603;
    --c-ink:    #1c2333;
    --c-muted:  #64748b;
    --c-light:  #94a3b8;
    --c-border: #e2e8f0;
    --c-bg:     #f1f5f9;
    --c-white:  #ffffff;
    --c-surface:#f8fafc;
    --ff-serif: 'Libre Baskerville', Georgia, serif;
    --ff-sans:  'Inter', 'Helvetica Neue', sans-serif;
    --r:        10px;
}

.ad-root {
    font-family: var(--ff-sans);
    background: var(--c-bg);
    min-height: 100vh;
}

/* ══ TITLE CARD ══ */
.ad-titlecard {
    background: var(--c-white);
    display: flex;
    border-bottom: 1px solid var(--c-border);
    box-shadow: 0 1px 8px rgba(7,42,97,0.06);
    margin-bottom: 28px;
    border-radius: 0 0 var(--r) var(--r);
    overflow: hidden;
}

.ad-titlecard__stripe {
    width: 6px;
    background: linear-gradient(180deg, var(--c-navy) 0%, var(--c-orange) 100%);
    flex-shrink: 0;
}

.ad-titlecard__body {
    padding: 36px 44px 32px;
    flex: 1;
}

.ad-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--ff-sans);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-orange);
    background: #fff7ed;
    border: 1px solid #fed7aa;
    padding: 4px 12px;
    border-radius: 100px;
    margin-bottom: 18px;
}

.ad-title {
    font-family: var(--ff-serif);
    font-size: clamp(22px, 2.8vw, 38px);
    font-weight: 700;
    color: var(--c-navy);
    line-height: 1.3;
    margin: 0 0 14px;
    letter-spacing: -0.01em;
}

.ad-subtitle {
    font-family: var(--ff-serif);
    font-size: 17px;
    color: var(--c-muted);
    font-style: italic;
    margin: 0 0 20px;
}

.ad-author-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 20px;
}

.ad-author-chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--ff-sans);
    font-size: 13px;
    font-weight: 500;
    color: var(--c-ink);
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    padding: 5px 12px 5px 6px;
    border-radius: 100px;
    transition: all 0.2s;
}

.ad-author-chip:hover {
    border-color: var(--c-blue);
    color: var(--c-blue);
}

.ad-author-chip__avatar {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--c-navy);
    color: var(--c-white);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    font-weight: 700;
    flex-shrink: 0;
}

.ad-metabar {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px 4px;
}

.ad-metabar__item {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--ff-sans);
    font-size: 12.5px;
    color: var(--c-muted);
}

.ad-metabar__item svg { color: var(--c-light); }

.ad-metabar__sep {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--c-border);
    flex-shrink: 0;
    margin: 0 6px;
}

.ad-metabar__link {
    color: var(--c-blue);
    text-decoration: none;
    font-weight: 500;
}

.ad-metabar__link:hover { color: var(--c-orange); }

.ad-metabar__item--doi { flex-wrap: wrap; }

/* ══ BODY GRID ══ */
.ad-grid {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 24px 60px;
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 24px;
    align-items: start;
}

/* ══ BLOCKS ══ */
.ad-block {
    background: var(--c-white);
    border-radius: var(--r);
    border: 1px solid var(--c-border);
    margin-bottom: 20px;
    overflow: visible;
    transition: box-shadow 0.25s;
}

.ad-block:hover {
    box-shadow: 0 4px 20px rgba(7,42,97,0.08);
}

.ad-block__label {
    display: flex;
    align-items: center;
    padding: 0 28px;
    height: 48px;
    border-bottom: 1px solid var(--c-border);
    background: var(--c-surface);
}

.ad-block__label span {
    font-family: var(--ff-sans);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-muted);
    position: relative;
}

.ad-block__label span::after {
    content: '';
    position: absolute;
    bottom: -14px;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--c-orange);
    border-radius: 1px;
}

.ad-block--cite  .ad-block__label span::after { background: #f59e0b; }
.ad-block--refs  .ad-block__label span::after { background: #10b981; }
.ad-block--bio   .ad-block__label span::after { background: #8b5cf6; }
.ad-block--license .ad-block__label span::after { background: var(--c-light); }

/* ══ ABSTRACT ══ */
.ad-abstract-inner {
    padding: 28px 28px 20px;
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 28px;
    align-items: start;
}

.ad-cover__img {
    width: 100%;
    border-radius: 8px;
    display: block;
    box-shadow: 0 4px 14px rgba(0,0,0,0.13);
}

.ad-cover {
    position: relative;
}

.ad-cover__date {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: rgba(7,42,97,0.88);
    color: var(--c-white);
    font-family: var(--ff-sans);
    font-size: 11px;
    font-weight: 600;
    text-align: center;
    padding: 6px 10px;
    border-radius: 0 0 8px 8px;
    letter-spacing: 0.04em;
}

.ad-abstract-text {
    font-family: var(--ff-sans);
    font-size: 15px;
    font-weight: 400;
    line-height: 1.9;
    color: #334155;
    text-align: justify;
    hyphens: auto;
}

/* No cover fallback */
.ad-abstract-inner:not(:has(.ad-cover)) {
    grid-template-columns: 1fr;
}

.ad-keywords {
    padding: 16px 28px 22px;
    border-top: 1px dashed var(--c-border);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
}

.ad-keywords__label {
    font-family: var(--ff-sans);
    font-size: 11.5px;
    font-weight: 700;
    color: var(--c-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-right: 4px;
    flex-shrink: 0;
}

.ad-kw {
    font-family: var(--ff-sans);
    font-size: 12.5px;
    color: var(--c-blue);
    background: #eff6ff;
    border: 1px solid #bfdbfe;
    padding: 3px 11px;
    border-radius: 100px;
    font-weight: 500;
    cursor: default;
    transition: all 0.18s;
}

.ad-kw:hover {
    background: var(--c-blue);
    color: var(--c-white);
    border-color: var(--c-blue);
}

/* ══ CITATION ══ */
.ad-cite-wrap {
    margin: 24px 28px 20px;
    position: relative;
    background: #fffbf5;
    border: 1px solid #fed7aa;
    border-radius: 8px;
    padding: 20px 24px 20px 56px;
}

.ad-cite-mark {
    position: absolute;
    left: 14px;
    top: 2px;
    font-family: Georgia, serif;
    font-size: 64px;
    line-height: 1;
    color: rgba(255,134,3,0.2);
    user-select: none;
}

.ad-cite-text {
    font-family: var(--ff-sans);
    font-size: 13.5px;
    line-height: 1.75;
    color: #374151;
}

.ad-cite-actions {
    padding: 0 28px 24px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
}

/* ══ BUTTONS ══ */
.ad-btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--ff-sans);
    font-size: 13px;
    font-weight: 600;
    border-radius: 7px;
    cursor: pointer;
    text-decoration: none;
    border: none;
    transition: all 0.2s ease;
    white-space: nowrap;
    padding: 10px 20px;
}

.ad-btn--solid {
    background: var(--c-navy);
    color: var(--c-white);
    box-shadow: 0 2px 8px rgba(7,42,97,0.2);
}

.ad-btn--solid:hover {
    background: var(--c-orange);
    box-shadow: 0 4px 12px rgba(255,134,3,0.3);
    color: var(--c-white);
}

.ad-btn--outline {
    background: transparent;
    color: var(--c-navy);
    border: 1.5px solid var(--c-border);
}

.ad-btn--outline:hover {
    border-color: var(--c-navy);
    background: var(--c-navy);
    color: var(--c-white);
}

.ad-btn--sm { padding: 7px 14px; font-size: 12px; }

/* Citation formats dropdown — original approach */
.ad-citation-dropdown-wrap {
    position: relative;
}

.citation-formats {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    background: var(--c-white);
    border: 1px solid var(--c-border);
    border-radius: 8px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.11);
    padding: 6px 0;
    min-width: 220px;
    z-index: 9999;
    display: none;
    list-style: none;
    margin: 0;
}

.citation-formats.show {
    display: block;
}

.citation-formats li a {
    display: block;
    padding: 9px 18px;
    font-family: var(--ff-sans);
    font-size: 13px;
    color: #374151;
    text-decoration: none;
    transition: background 0.15s;
}

.citation-formats li a:hover {
    background: #f3f4f6;
    color: var(--c-blue);
}

/* ══ REFERENCES ══ */
.ad-refs { padding: 20px 28px; }

.ad-reflist {
    list-style: none;
    padding: 0;
    margin: 0;
    counter-reset: rc;
}

.ad-refitem {
    counter-increment: rc;
    position: relative;
    padding: 10px 12px 10px 46px;
    margin-bottom: 2px;
    border-radius: 7px;
    font-family: var(--ff-sans);
    font-size: 13.5px;
    line-height: 1.65;
    color: #374151;
    transition: background 0.16s;
}

.ad-refitem:hover { background: var(--c-surface); }

.ad-refitem::before {
    content: counter(rc);
    position: absolute;
    left: 10px;
    top: 10px;
    width: 25px;
    height: 25px;
    background: var(--c-navy);
    color: var(--c-white);
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10.5px;
    font-weight: 700;
}

.ad-refs-raw {
    font-family: var(--ff-sans);
    font-size: 13.5px;
    line-height: 1.7;
    color: #374151;
}

.ad-refs-toggle {
    padding: 0 28px 22px;
    display: flex;
    justify-content: center;
}

/* ══ BIOGRAPHIES ══ */
.ad-bio {
    display: flex;
    gap: 0;
    padding: 24px 28px;
    border-top: 1px solid var(--c-border);
}

.ad-bio:first-of-type { border-top: none; }

.ad-bio__left {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-right: 20px;
    flex-shrink: 0;
}

.ad-bio__avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--c-navy) 0%, #1a54aa 100%);
    color: var(--c-white);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--ff-sans);
    font-size: 17px;
    font-weight: 700;
    flex-shrink: 0;
}

.ad-bio__vline {
    width: 1px;
    flex: 1;
    background: var(--c-border);
    margin-top: 10px;
    min-height: 20px;
}

.ad-bio__name {
    font-family: var(--ff-sans);
    font-size: 15px;
    font-weight: 700;
    color: var(--c-navy);
    margin: 0 0 2px;
}

.ad-bio__affil {
    font-family: var(--ff-sans);
    font-size: 12px;
    color: var(--c-muted);
    font-style: italic;
    margin: 0 0 10px;
}

.ad-bio__text {
    font-family: var(--ff-sans);
    font-size: 13.5px;
    line-height: 1.65;
    color: #4b5563;
}

/* ══ LICENSE ══ */
.ad-license {
    padding: 22px 28px;
    font-family: var(--ff-sans);
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--c-muted);
}

.ad-license__link {
    color: var(--c-blue);
    font-weight: 600;
    text-decoration: none;
}

.ad-license__link:hover { color: var(--c-orange); text-decoration: underline; }

/* ══ SIDEBAR ══ */
.ad-sidebar {
    position: sticky;
    top: 20px;
}

.ad-sb-cta {
    background: var(--c-navy);
    border-radius: var(--r);
    overflow: hidden;
    margin-bottom: 16px;
    box-shadow: 0 4px 16px rgba(7,42,97,0.25);
}

.ad-sb-cta__head {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 14px 18px;
    background: rgba(255,255,255,0.08);
    font-family: var(--ff-sans);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.7);
    border-bottom: 1px solid rgba(255,255,255,0.1);
}

.ad-sb-cta__head svg { color: rgba(255,255,255,0.5); }

.ad-sb-cta__body { padding: 16px; }

.ad-sb-cta__body .btn,
.ad-sb-cta__body a.btn {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 8px !important;
    background: rgba(255,255,255,0.12) !important;
    color: var(--c-white) !important;
    border: 1px solid rgba(255,255,255,0.2) !important;
    padding: 12px 16px !important;
    border-radius: 7px !important;
    font-family: var(--ff-sans) !important;
    font-size: 13.5px !important;
    font-weight: 600 !important;
    text-decoration: none !important;
    text-align: center !important;
    width: 100% !important;
    margin-bottom: 8px !important;
    transition: all 0.22s !important;
}

.ad-sb-cta__body .btn:hover,
.ad-sb-cta__body a.btn:hover {
    background: var(--c-orange) !important;
    border-color: var(--c-orange) !important;
    transform: translateY(-2px) !important;
}

.ad-sb-cta__body .btn::before,
.ad-sb-cta__body a.btn::before {
    content: "\f1c1";
    font-family: "Font Awesome 5 Free";
    font-weight: 900;
    font-size: 15px;
}

.ad-sb-cta__body .btn i.fa,
.ad-sb-cta__body a.btn i.fa { display: none !important; }

/* Sidebar widgets */
.ad-sb-widget {
    background: var(--c-white);
    border: 1px solid var(--c-border);
    border-radius: var(--r);
    overflow: hidden;
    margin-bottom: 14px;
    transition: box-shadow 0.2s;
}

.ad-sb-widget:hover {
    box-shadow: 0 3px 14px rgba(7,42,97,0.08);
}

.ad-sb-widget__title {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 11px 16px;
    background: var(--c-surface);
    border-bottom: 1px solid var(--c-border);
    font-family: var(--ff-sans);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-navy);
    margin: 0;
}

.ad-sb-widget__title svg { color: var(--c-orange); flex-shrink: 0; }

.ad-sb-widget__body { padding: 14px 16px; }

.ad-sb-issue {
    display: block;
    font-family: var(--ff-sans);
    font-size: 13.5px;
    font-weight: 600;
    color: var(--c-blue);
    text-decoration: none;
    line-height: 1.45;
    margin-bottom: 10px;
}

.ad-sb-issue:hover { color: var(--c-orange); }

.ad-sb-section {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-top: 10px;
    border-top: 1px solid var(--c-border);
}

.ad-sb-section__label {
    font-family: var(--ff-sans);
    font-size: 9.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--c-light);
}

.ad-sb-section__val {
    font-family: var(--ff-sans);
    font-size: 13px;
    color: #374151;
}

.ad-sb-plain {
    font-family: var(--ff-sans);
    font-size: 13px;
    color: #374151;
    line-height: 1.55;
    word-break: break-word;
}

.ad-sb-plain a {
    color: var(--c-blue);
    text-decoration: none;
}

.ad-sb-plain a:hover { color: var(--c-orange); text-decoration: underline; }

/* ══ RESPONSIVE ══ */
@media (max-width: 1100px) {
    .ad-grid { grid-template-columns: 1fr 300px; }
    .ad-sidebar { position: static; }
}

@media (max-width: 900px) {
    .ad-grid {
        grid-template-columns: 1fr;
        padding: 0 16px 48px;
    }
    .ad-abstract-inner { grid-template-columns: 1fr; }
    .ad-cover { max-width: 300px; margin: 0 auto 16px; }
}

@media (max-width: 768px) {
    .ad-titlecard__body { padding: 24px 20px; }
    .ad-title { font-size: 22px; }
    .ad-block__label { padding: 0 20px; }
    .ad-abstract-inner,
    .ad-cite-wrap,
    .ad-refs,
    .ad-cite-actions,
    .ad-refs-toggle,
    .ad-license { padding-left: 20px; padding-right: 20px; }
    .ad-keywords { padding: 14px 20px 18px; }
}

@media (max-width: 480px) {
    .ad-titlecard__body { padding: 20px 16px; }
    .ad-grid { padding: 0 12px 40px; }
}
</style>


<script>
// Toggle References — show only 15 initially
(function () {
    const list = document.querySelector('.ad-reflist:not(.ad-reflist--old)');
    const btn  = document.getElementById('btn-toggle-references');
    if (!list || !btn) return;

    const items = list.querySelectorAll('.ad-refitem');
    const LIMIT = 15;
    let expanded = false;

    if (items.length <= LIMIT) {
        btn.style.display = 'none';
        return;
    }

    // Hide items beyond limit on load
    items.forEach((item, i) => {
        if (i >= LIMIT) item.style.display = 'none';
    });

    btn.addEventListener('click', function () {
        expanded = !expanded;
        items.forEach((item, i) => {
            if (i >= LIMIT) item.style.display = expanded ? 'list-item' : 'none';
        });
        this.innerHTML = expanded
            ? `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/></svg> Show Less`
            : `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg> Show More`;
    });
})();

// Citation Format Dropdown — original approach
document.querySelector('.btn-citation-format')?.addEventListener('click', function(e) {
    e.stopPropagation();
    const dropdown = this.nextElementSibling;
    dropdown?.classList.toggle('show');
});

document.addEventListener('click', function(e) {
    if (!e.target.closest('.ad-citation-dropdown-wrap')) {
        document.querySelectorAll('.citation-formats').forEach(d => d.classList.remove('show'));
    }
});
</script>            
        </div>


    </div><!-- .page -->
</div>

