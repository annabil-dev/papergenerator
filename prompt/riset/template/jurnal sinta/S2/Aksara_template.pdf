		type: 'bar',
		data: {
			labels: [
									2022,									2023,									2024,									2025,									2026,							],
			datasets: [{
				label: 'Articles',
				data: [
											15,											13,											7,											9,											1,									],
				backgroundColor: [
											'rgba(56, 188, 0, 0.2)',
											'rgba(56, 188, 0, 0.2)',
											'rgba(56, 188, 0, 0.2)',
											'rgba(56, 188, 0, 0.2)',
											'rgba(56, 188, 0, 0.2)',
									],
				borderColor: [
