		  	 <article class="obj_article_details">

		
	<h1 class="page_title">
		Negotiating The Authority of Female Ulama in the Reinterpretation of the Qur'an in Islamic Family Law in East Kalimantan
	</h1>

	
	<div class="row">
		<div class="main_entry">

							<section class="item authors">
					<h2 class="pkp_screen_reader">Authors</h2>
					<ul class="authors">
											<li>
							<span class="name">
								Iskandar Zainuddin
							</span>
															<span class="affiliation">
									Universitas Islam Negeri Sultan Aji Muhammad Idris Samarinda, Indonesia
																	</span>
																																		</li>
											<li>
							<span class="name">
								Ahmad Yusam Thobroni
							</span>
