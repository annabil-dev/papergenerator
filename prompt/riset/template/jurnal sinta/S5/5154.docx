<style>
/* =====================================

/* =====================================
   NAVIGATION MENU FONT - INTER
===================================== */

/* Apply Inter font to all navigation elements */
#navigationPrimary,
#navigationPrimary *,
#navigationUser,
#navigationUser * {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif !important;
}

/* Main Navigation Menu Styling */
#navigationPrimary .navbar-nav > li > a {
    font-family: 'Inter', sans-serif !important;
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.3px;
    color: #2d3748;
    text-transform: none;
    transition: color 0.3s ease;
}

/* Hover and Focus States */
#navigationPrimary .navbar-nav > li > a:hover,
#navigationPrimary .navbar-nav > li > a:focus {
    color: #072A61;
}

/* Dropdown Menu Styling */
#navigationPrimary .dropdown-menu {
    font-family: 'Inter', sans-serif !important;
}

#navigationPrimary .dropdown-menu li a {
    font-family: 'Inter', sans-serif !important;
    font-size: 14px;
    font-weight: 400;
    color: #2d3748;
}

#navigationPrimary .dropdown-menu li a:hover {
    color: #072A61;
    background-color: #f8f9fa;
}

/* User Navigation */
