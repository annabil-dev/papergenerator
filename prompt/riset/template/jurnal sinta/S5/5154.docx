<script>
function toggleSocialMedia() {
    const socialMedia = document.querySelector('.sosmed-menu');
    const contactBtn  = document.querySelector('.contact-btn');

    const isOpen = socialMedia.classList.contains('show');

    if (isOpen) {
        socialMedia.classList.remove('show');
        socialMedia.classList.add('hide');
        contactBtn.classList.remove('open');
        setTimeout(() => {
            socialMedia.classList.remove('hide');
        }, 650);
    } else {
        socialMedia.classList.add('show');
        contactBtn.classList.add('open');
    }
}

// Close on outside click
document.addEventListener('click', function(e) {
    const menu = document.querySelector('.sosmed-menu');
    const btn  = document.querySelector('.contact-btn');
    if (menu && btn && !menu.contains(e.target) && !btn.contains(e.target)) {
        menu.classList.remove('show');
        btn.classList.remove('open');
    }
});
</script>

