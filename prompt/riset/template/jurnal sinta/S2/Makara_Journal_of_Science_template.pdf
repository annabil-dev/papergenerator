<script type="text/javascript">
    $('.ui.checkbox').checkbox();
    $('select.dropdown').dropdown();
    $('.ui.dropdown').dropdown();
    $('.top.menu .item').tab();

    $(document).ready(function () {

        $("#sort").change(function () {
            var page = 1;
            // $("#sort").val(page);
            $("#form_sort").submit();
        });

        $("#select_item").change(function () {
            var page = 1;
            $("#page").val(page);
            $("#form_journal").submit();
        });        

        $("#select_item").change(function () {
            var page = 1;
            $("#page").val(page);
            $("#form_alphabeth").submit();
        });

        $("#select_item").change(function () {
            var page = 1;
            $("#page").val(page);
            $("#form_search").submit();
        });

        $('#page').keydown(function () {
            var key = e.which;
            if (key == 13) {
                $('#form_journal').submit();
            }
        });

        $('#form_journal').keydown(function () {
            var key = e.which;
            if (key == 13) {
                // As ASCII code for ENTER key is "13"
                $('#form_journal').submit(); // Submit form code
            }
        });

        $('.demo.menu .item').tab({history: false});

        $('.area-cloud a').tagcloud();

    });

    $('.ui.top.attached.tabular.menu .item').tab({history: false});

    $.fn.tagcloud.defaults = {
        size: {start: 9, end: 30, unit: 'pt'},
        color: {start: '#444', end: '#ed462f'}
    };

    function show_abstract(id){
        $('#show_abstract'+id).slideToggle();
    }

    $(document).ready(function () {
        $('#adv-btn').on('click', function () {
            $('#adv-box').slideToggle('slow');
            $('#form-journal').slideToggle('slow');
        });

        $('#adv-less').on('click', function () {
            $('#adv-box').slideToggle('slow');
            $('#form-journal').slideToggle('slow');
        });
    });



</script>

