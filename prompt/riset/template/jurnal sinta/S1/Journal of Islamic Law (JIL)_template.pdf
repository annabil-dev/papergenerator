<div style="padding-top: 3px; line-height: 1;">
<div style="float: left; font-size: 28px;"><a href="https://www.scopus.com/sourceid/21101210522" target="_blank" rel="noopener"> <span id="citescoreVal" style="letter-spacing: -2px; display: inline-block; padding-top: 7px; line-height: .75;">5.1</span> </a></div>
<div style="float: right; font-size: 14px; padding-top: 3px; text-align: right;"><a href="https://www.scopus.com/sourceid/21101210522" target="_blank" rel="noopener"> <span id="citescoreYearVal" style="display: block;">2024</span>CiteScore </a></div>
