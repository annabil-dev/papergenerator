<script>
// Clean JavaScript without sidemenu references
document.addEventListener('DOMContentLoaded', function() {
// Tab functionality untuk journal section
function showOverviewTab() {
  var overviewTab = document.getElementById('overview-tab');
  var overviewContent = document.getElementById('journalOverview');
  
  if (overviewTab && overviewContent) {
      var allTabs = document.querySelectorAll('#journalTab .nav-link');
      allTabs.forEach(function(tab) {
          tab.classList.remove('active');
          tab.setAttribute('aria-selected', 'false');
      });
      
      var allPanes = document.querySelectorAll('#journalTabContent .tab-pane');
      allPanes.forEach(function(pane) {
          pane.classList.remove('show', 'active');
      });
      
      overviewTab.classList.add('active');
      overviewTab.setAttribute('aria-selected', 'true');
      overviewContent.classList.add('show', 'active');
      
      if (typeof jQuery !== 'undefined') {
          try {
              jQuery('#overview-tab').tab('show');
          } catch(e) {
              console.log('jQuery tab method failed, using direct DOM manipulation');
          }
      }
  }
}

showOverviewTab();
setTimeout(showOverviewTab, 100);
setTimeout(showOverviewTab, 500);

var tabs = document.querySelectorAll('#journalTab a');
tabs.forEach(function(tab) {
    tab.addEventListener('click', function(e) {
        e.preventDefault();
        
        tabs.forEach(function(t) {
            t.classList.remove('active');
            t.setAttribute('aria-selected', 'false');
        });
        
        var tabContents = document.querySelectorAll('.tab-pane');
        tabContents.forEach(function(content) {
            content.classList.remove('show', 'active');
        });
        
        this.classList.add('active');
        this.setAttribute('aria-selected', 'true');
        
        var targetId = this.getAttribute('href').substring(1);
        var targetContent = document.getElementById(targetId);
        if (targetContent) {
            targetContent.classList.add('show', 'active');
        }
        
        if (typeof jQuery !== 'undefined') {
            try {
                jQuery(this).tab('show');
            } catch(e) {
                console.log('jQuery tab method failed, using direct DOM manipulation');
            }
        }
    });
});

// Fungsi tanggal Hijriah
window.updateFooterDates = function() {
    function isLeapYear(year) {
        return ((year % 4 === 0) && (year % 100 !== 0)) || (year % 400 === 0);
    }

    function julianDay(date) {
        const year = date.getFullYear();
        const month = date.getMonth() + 1;
        const day = date.getDate();
        
        let a = Math.floor((14 - month) / 12);
        let y = year - a;
        let m = month + 12 * a - 3;
        
        return day + Math.floor((153 * m + 2) / 5) + 365 * y + Math.floor(y / 4) - Math.floor(y / 100) + Math.floor(y / 400) + 1721119;
    }

    function hijriDate(date) {
        const jd = julianDay(date);
        const l = jd - 1948440 + 10632;
        const n = Math.floor((l - 1) / 10631);
        const l2 = l - 10631 * n + 354;
        const j = Math.floor((10985 - l2) / 5316) * Math.floor((50 * l2) / 17719) + Math.floor(l2 / 5670) * Math.floor((43 * l2) / 15238);
        const l3 = l2 - Math.floor((30 - j) / 15) * Math.floor((17719 * j) / 50) - Math.floor(j / 16) * Math.floor((15238 * j) / 43) + 29;
        const m = Math.floor((24 * l3) / 709);
        const d = l3 - Math.floor((709 * m) / 24);
        const y = 30 * n + j - 30;
        
        return { day: d, month: m, year: y };
    }

    function getHijriMonthName(month) {
        const months = [
            'Muharram', 'Safar', 'Rabi al-Awwal', 'Rabi al-Thani',
            'Jumada al-Awwal', 'Jumada al-Thani', 'Rajab', 'Shaban',
            'Ramadan', 'Shawwal', 'Dhu al-Qidah', 'Dhu al-Hijjah'
        ];
        return months[month - 1] || '';
    }

    const now = new Date();
    
    const gregorianDate = now.toLocaleDateString('id-ID', {
        weekday: 'long',
        day: 'numeric',
        month: 'long',
        year: 'numeric',
        timeZone: 'Asia/Jakarta'
    });
    
    const hijri = hijriDate(now);
    const hijriMonthName = getHijriMonthName(hijri.month);
    const hijriDateStr = hijri.day + ' ' + hijriMonthName + ' ' + hijri.year + ' H';
    
    const hijriShort = document.getElementById('hijri-date');
    const hijriFull = document.getElementById('hijri-full');
    const gregorianFull = document.getElementById('gregorian-date');
    
    if (hijriShort) {
        hijriShort.textContent = hijriDateStr.split(' ')[0] + ' ' + hijriDateStr.split(' ')[1] + ' - ' + gregorianDate.split(',')[0];
    }
    if (hijriFull) {
        hijriFull.textContent = 'Hijri: ' + hijriDateStr;
    }
    if (gregorianFull) {
        gregorianFull.textContent = 'Gregorian: ' + gregorianDate;
    }
};

window.updateFooterDates();
setInterval(window.updateFooterDates, 3600000);
});

if (document.readyState === 'loading') {
document.addEventListener('DOMContentLoaded', showOverviewTab);
} else {
showOverviewTab();
}

window.addEventListener('load', function() {
showOverviewTab();
setTimeout(showOverviewTab, 100);
});
</script>

