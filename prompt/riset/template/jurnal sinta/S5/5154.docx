                                                                                                                                                                                        <span class="ad-metabar__sep"></span>
                        <span class="ad-metabar__item ad-metabar__item--doi">
                            <span class="ai ai-doi"></span>
                            <a href="https://doi.org/10.35912/kihan.v4i2.5154" target="_blank" class="ad-metabar__link">https://doi.org/10.35912/kihan.v4i2.5154</a>
